{
  "manifestVersion": 1,
  "suite": "TealSuite",
  "suiteVersion": "1.8.0",
  "apps": [
    {
      "id": "TealHub",
      "name": "Teal Hub",
      "role": "アプリ管理",
      "exe": "TealHub.exe",
      "version": "1.8.0",
      "description": "TealSuite のアプリをまとめて起動・終了。各アプリのショートカット・常駐・スタートアップとアップデートもここから",
      "icon": "TealHub.ico",
      "legacyIds": ["AppManager"],
      "self": true,
      "shortcuts": [
        {"slot": "open", "label": "画面を開く / 隠す", "default": "Alt+H"}
      ],
      "resident": true
    },
    {
      "id": "TealPass",
      "name": "Teal Pass",
      "role": "パスワード管理",
      "exe": "apps/TealPass/TealPass.exe",
      "version": "1.8.0",
      "description": "パスワードの生成・保管・管理。サイトごとにメモも残せます",
      "icon": "apps/TealPass/TealPass.ico",
      "legacyIds": ["PasswordMaker"],
      "shortcuts": [
        {"slot": "open", "label": "画面を開く"}
      ],
      "resident": false
    },
    {
      "id": "TealMemo",
      "name": "Teal Memo",
      "role": "メモ",
      "exe": "apps/TealMemo/TealMemo.exe",
      "version": "1.8.0",
      "description": "思いついたことをすぐに書き留めるメモ帳。自動保存",
      "icon": "apps/TealMemo/TealMemo.ico",
      "legacyIds": ["Memo"],
      "shortcuts": [
        {"slot": "open", "label": "画面を開く"}
      ],
      "resident": false
    },
    {
      "id": "TealClip",
      "name": "Teal Clip",
      "role": "コピー履歴",
      "exe": "apps/TealClip/TealClip.exe",
      "version": "1.8.0",
      "description": "コピーした文字を10件まで記録。ショートカットで呼び出し (常駐がおすすめ)",
      "icon": "apps/TealClip/TealClip.ico",
      "legacyIds": ["ClipboardHistory"],
      "shortcuts": [
        {"slot": "popup", "label": "履歴を呼び出す", "default": "Ctrl+Shift+V"}
      ],
      "resident": true
    },
    {
      "id": "TealVolume",
      "name": "Teal Volume",
      "role": "音量操作",
      "exe": "apps/TealVolume/TealVolume.exe",
      "version": "1.8.0",
      "description": "アプリごとの音量を調整。ショートカットでミキサーを開閉",
      "icon": "apps/TealVolume/TealVolume.ico",
      "legacyIds": ["VolumeMixer"],
      "shortcuts": [
        {"slot": "open", "label": "ミキサーを開く / 隠す", "default": "Alt+V"}
      ],
      "resident": false
    },
    {
      "id": "TealSub",
      "name": "Teal Sub",
      "role": "サブスク整理",
      "exe": "apps/TealSub/TealSub.exe",
      "version": "1.8.0",
      "description": "サブスクの金額・次の支払い日・解約の見直しをまとめて管理。更新日の前にお知らせ",
      "icon": "apps/TealSub/TealSub.ico",
      "legacyIds": [],
      "shortcuts": [
        {"slot": "open", "label": "画面を開く / 隠す"}
      ],
      "resident": true,
      "residentNote": "更新日・無料期間の終わりのお知らせは、起動している (常駐している) 間だけ出ます。"
    },
    {
      "id": "TealTasks",
      "name": "Teal Tasks",
      "role": "タスク管理＆カレンダー",
      "exe": "apps/TealTasks/TealTasks.exe",
      "version": "1.8.0",
      "description": "やることを期限・優先度つきで管理。カレンダーで予定を見ながらドラッグで日程変更",
      "icon": "apps/TealTasks/TealTasks.ico",
      "legacyIds": [],
      "shortcuts": [
        {"slot": "open", "label": "画面を開く / 隠す"}
      ],
      "resident": true,
      "residentNote": "期限のお知らせは、起動している (常駐している) 間だけ出ます。"
    }
  ]
}
